rand_dm_type %>% tabyl(mental_health)
rand_dm_type %>% tabyl(physical_health)
rand_dm_type %>% tabyl(age_grp)
rand_dm_type %>% tabyl(last_checkup)
rand_dm_type %>% tabyl(exercise)
rand_dm_type %>% tabyl(heart_attack)
rand_dm_type %>% tabyl(asthma)
rand_dm_type %>% tabyl(stroke)
rand_dm_type %>% tabyl(ever_depression)
rand_dm_type %>% tabyl(ever_arthritis)
rand_dm_type %>% tabyl(dm_type)
rand_dm_type %>% tabyl(dm_education)
rand_dm_type %>% tabyl(memory)
rand_dm_type %>% tabyl(walk)
rand_dm_type %>% tabyl(deaf)
rand_dm_type %>% tabyl(sight)
# Chunk 12
data_model_vars <- rand_dm_type %>%
select(
id, sex, metropolis, bmi_cat, marital, education, employment, ethnicity, age_grp, physical_health, mental_health, last_checkup, exercise, heart_attack, stroke, sight, memory, walk, deaf, ever_arthritis, asthma, ever_depression, age_had_dm, dm_type)
summary(data_model_vars)
# Chunk 13
final_data <- data_model_vars %>%
drop_na(
id, sex, metropolis, bmi_cat, marital, education, employment, ethnicity, age_grp, physical_health, mental_health, last_checkup, exercise, heart_attack, stroke, sight, memory, walk, deaf, ever_arthritis, asthma, ever_depression, age_had_dm, dm_type)
summary(final_data)
# Chunk 14
final_data_recoded <- final_data %>%
mutate(
sex = case_when(
sex == 2 ~ 1,
sex == 1 ~ 0, #male ref level
.default = sex
),
metropolis = case_when(
metropolis == 1 ~ 0, #yes
metropolis == 2 ~ 1,
.default = metropolis
),
sight = case_when(
sight == 2 ~ 0, #no ref
.default = sight
),
memory = case_when(
memory == 2 ~ 0, #no ref
.default = memory
),
walk = case_when(
walk == 2 ~ 0, #no ref
.default = walk
),
deaf = case_when(
deaf == 2 ~ 0, #no ref
.default = deaf
),
bmi_cat = case_when(
bmi_cat == 2 ~ 0, #normal weight ref level
bmi_cat == 1 ~ 1,
bmi_cat == 3 ~ 2,
bmi_cat == 4 ~ 3,
.default = bmi_cat
),
marital = case_when(
marital == 1 ~ 0, #married ref
marital == 2 ~ 1,
marital == 3 ~ 1,
marital == 4 ~ 1,
marital == 5 ~ 2,
marital == 6 ~ 2,
.default = marital
),
education = case_when(
education == 4 ~ 0, #college complete ref
.default = education
),
employment = case_when(
employment == 1 ~ 0, #employed/self-employed ref.
employment == 2 ~ 0,
employment == 3 ~ 1,
employment == 4 ~ 1,
employment == 5 ~ 1,
employment == 6 ~ 1,
employment == 7 ~ 1,
employment == 8 ~ 1,
.default = employment
),
ethnicity = case_when(
ethnicity == 1 ~ 0, #white ref.
ethnicity == 2 ~ 1, #black
ethnicity == 3 ~ 2,
ethnicity == 4 ~ 2,
ethnicity == 5 ~ 2,
ethnicity == 6 ~ 2,
.default = ethnicity
),
age_grp = case_when(
age_grp == 6 ~ 0, #65 years and older ref
age_grp == 1 ~ 1,
age_grp == 2 ~ 1,
age_grp == 3 ~ 1,
age_grp == 4 ~ 1,
age_grp == 5 ~ 2,
.default = age_grp
),
physical_health = case_when(
physical_health == 1 ~ 0, #zero days ref
physical_health == 2 ~ 1,
physical_health == 3 ~ 2,
.default = physical_health
),
mental_health = case_when(
mental_health == 1 ~ 0, #zero days ref
mental_health == 2 ~ 1,
mental_health == 3 ~ 2,
.default = mental_health
),
last_checkup = case_when(
last_checkup == 1 ~ 0, #within last year ref
last_checkup == 2 ~ 1,
last_checkup == 3 ~ 1,
last_checkup == 4 ~ 1,
last_checkup == 5 ~ 1,
.default = last_checkup
),
exercise = case_when(
exercise == 1 ~ 0, # yes ref
exercise == 2 ~ 1,
.default = exercise
),
stroke = case_when(
stroke == 2 ~ 0,
.default = stroke
),
asthma = case_when(
asthma == 2 ~ 0,
.default = asthma
),
heart_attack = case_when(
heart_attack == 2 ~ 0,
.default = heart_attack
),
ever_depression = case_when(
ever_depression == 2 ~ 0,
.default = ever_depression
),
ever_arthritis = case_when(
ever_arthritis == 2 ~ 0,
.default = ever_arthritis
),
dm_type = case_when(
dm_type == 2 ~ 0,
.default = dm_type
)
)
summary(final_data_recoded)
# Chunk 15
skim(final_data_recoded)
final_data_recoded %>% tabyl(sex)
final_data_recoded %>% tabyl(metropolis)
final_data_recoded %>% tabyl(bmi_cat)
final_data_recoded %>% tabyl(marital)
final_data_recoded %>% tabyl(ethnicity)
final_data_recoded %>% tabyl(education)
final_data_recoded %>% tabyl(employment)
final_data_recoded %>% tabyl(mental_health)
final_data_recoded %>% tabyl(physical_health)
final_data_recoded %>% tabyl(age_grp)
final_data_recoded %>% tabyl(last_checkup)
final_data_recoded %>% tabyl(exercise)
final_data_recoded %>% tabyl(heart_attack)
final_data_recoded %>% tabyl(asthma)
final_data_recoded %>% tabyl(stroke)
final_data_recoded %>% tabyl(ever_depression)
final_data_recoded %>% tabyl(ever_arthritis)
final_data_recoded %>% tabyl(dm_type)
final_data_recoded %>% tabyl(memory)
final_data_recoded %>% tabyl(walk)
final_data_recoded %>% tabyl(deaf)
final_data_recoded %>% tabyl(sight)
# Chunk 16
diabetes_data_factor <- final_data_recoded %>%
mutate(across(c(sex, bmi_cat, sight, memory, walk, deaf, metropolis, marital, education, employment, ethnicity, age_grp, physical_health, mental_health, last_checkup, exercise, heart_attack, stroke, asthma, ever_depression, ever_arthritis, dm_type), as.factor))
# Chunk 17
set.seed(1123581321)
data_split <- initial_validation_split(
diabetes_data_factor,
strata = dm_type,
prop = c(0.6, 0.05))
train_data <- training(data_split)
test_data     <- testing(data_split)
# Chunk 18
rm_covsum(
data = final_data_recoded,
covs = c('sex', 'metropolis', 'bmi_cat', 'marital', 'education', 'employment', 'ethnicity',
'age_grp', 'physical_health', 'mental_health', 'last_checkup', 'exercise', 'heart_attack', 'stroke', 'asthma', 'ever_depression', 'ever_arthritis', 'age_had_dm', 'dm_type')
)
# Chunk 19
logistic_model <- logistic_reg() %>%
set_engine("glm") %>%
set_mode("classification") %>%
fit(ever_depression ~ ., data = train_data)
# Chunk 20
pred_class <- predict(logistic_model,
new_data = test_data,
type = "class")
table(pred_class$.pred_class)
# Chunk 21
table(test_data$ever_depression)
# Chunk 22
pred_prob <- predict(logistic_model,
new_data = test_data,
type = "prob")
head(pred_prob)
# Chunk 23
diabetes_results <- test_data %>%
select(ever_depression) %>%
bind_cols(pred_class, pred_prob)
head(diabetes_results)
# Chunk 24
conf_mat(diabetes_results, truth = ever_depression,
estimate = .pred_class)
# Chunk 25
accuracy(diabetes_results, truth = ever_depression,
estimate = .pred_class)
# Chunk 26
sens(diabetes_results, truth = ever_depression,
estimate = .pred_class)
# Chunk 27
spec(diabetes_results, truth = ever_depression,
estimate = .pred_class)
# Chunk 28
precision(diabetes_results, truth = ever_depression,
estimate = .pred_class)
# Chunk 29
roc_auc(diabetes_results,
truth = ever_depression,
.pred_0)
roc_curve <- diabetes_results %>%
roc_curve(truth = ever_depression, .pred_0) %>%
autoplot()
plot(roc_curve)
# Chunk 30
metrics <- metric_set(accuracy, sens, spec, precision, recall, f_meas)
all_metrics_lr <- metrics(diabetes_results,
truth = ever_depression,
estimate = .pred_class)
kable(all_metrics_lr)
# Chunk 31
coeff <- tidy(logistic_model) %>%
filter(term != "(Intercept)") %>%
arrange(desc(abs(estimate))) %>%
slice_head(n = 15)
kable(coeff)
ggplot(coeff, aes(x = reorder(term, abs(estimate)), y = estimate, fill = estimate > 0)) +
geom_col() +
coord_flip() +
scale_fill_manual(values = c("tomato", "steelblue"),
labels = c("Decrease", "Increase"),
name   = "Odds person with DM has depression") +
labs(
title = "Top 10 Most Important Features — Logistic Regression",
x     = NULL,
y     = "Coefficient Estimate"
) +
theme_minimal()
# Chunk 32
diabetes_recipe <-
recipe(ever_depression ~ ., data = train_data) %>%
step_unknown() %>%
step_dummy(all_nominal_predictors()) %>%
step_normalize(all_numeric_predictors()) %>% ### Mean center and standardize (z-score) the numeric predictors
step_zv(all_predictors())
# Chunk 33
knn_m <- nearest_neighbor(neighbors = tune()) |>
set_mode("classification") |>
set_engine("kknn")
k_tuning <- grid_regular(
neighbors(range = c(2,10)
))
ctrl <- control_resamples(save_pred = TRUE)
cross_validation <- vfold_cv(train_data, v = 5)
# Chunk 34
diabetes_wflow_knn <-
workflow() %>%
add_model(knn_m) %>%
add_recipe(diabetes_recipe)
diabetes_wflow_knn
# Chunk 35
knn_tune <- tune_grid(
diabetes_wflow_knn,
resamples = cross_validation,
grid = k_tuning,
control = ctrl
)
# Chunk 1
library(janitor)
library(skimr)
library(tidyverse)
library(tidymodels)
library(tidytext)
library(tidyclust)
library(ClusterR)
library(klaR)
library(GGally)
library(knitr)
library(gtsummary)
library(devtools)
library(ggmosaic)
library(reportRmd)
library(sjPlot)
library(plotly)
library(psych)
library(parallel)
library(finalfit)
library(gtsummary)
library(mlbench)
library(vip)
library(rsample)
library(tune)
library(recipes)
library(yardstick)
library(parsnip)
library(glmnet)
library(themis)
library(corrr)
library(performance)
library(utils)
library(see)
library(themis)
library(kknn)
library(microbenchmark)
# Chunk 2
brfss_data24 <- read_csv("../brfssdata/brfss24.csv")
# Chunk 3
fp_data_vars <- brfss_data24 %>%
select(
id = SEQNO,                         metropolis = '_METSTAT',            marital = MARITAL,
state = '_STATE',                   sex = SEXVAR,
bmi = "_BMI5",                      bmi_cat = "_BMI5CAT",               education = '_EDUCAG',
employment = EMPLOY1,               sight = BLIND,                      age =  '_AGE80',
age_grp = '_AGE_G',                 ethnicity = "_IMPRACE",             income2 = '_INCOMG1',
income = INCOME3,                   weight_lb = WEIGHT2,                height_in = HEIGHT3,
health_rating = GENHLTH,            physical_health = '_PHYS14D',       mental_health = '_MENT14D',
memory = DECIDE,                    walk = DIFFWALK,                    deaf = DEAF,                                       health_insurance = PRIMINS2,        exercise = EXERANY2,
is_insured = '_HLTHPL2',            last_checkup = CHECKUP1,            heart_attack = CVDINFR4,                           coronary_hd = CVDCRHD4,             stroke = CVDSTRK3,                 asthma = ASTHMA3,                                   ever_cancer = CHCOCNC1,             ever_copd = CHCCOPD3,
ever_depression = ADDEPEV3,         ever_ckd = CHCKDNY2,                age_had_dm = DIABAGE4,
ever_arthritis = HAVARTH4,          ever_diabetes = DIABETE4,           dm_type = DIABTYPE,
checked_hba1c = CHKHEMO3,           dm_education = DIABEDU1,            dm_feet = FEETSORE,
)
# Chunk 4
fp_data <- fp_data_vars %>%
mutate(
ever_diabetes = case_when(
ever_diabetes > 1 ~ NA_real_, #code as missing
.default = ever_diabetes
))
fp_data_sample <- fp_data %>% drop_na('ever_diabetes' )
knows_dm_type <- fp_data %>% drop_na('dm_type' )
fp_data_sample %>% tabyl(ever_diabetes)
knows_dm_type %>% tabyl(dm_type)
fp_data_sample %>% tabyl(dm_type)
set.seed(1123581321)
fp_data_sample2 <- fp_data_sample %>%
mutate(row_id = row_number()) %>%
left_join(
fp_data_sample %>%
mutate(row_id = row_number()) %>%
filter(is.na(dm_type) | dm_type == 7) %>%
slice_sample(prop = 0.9) %>%
mutate(to_recode = TRUE) %>%
select(row_id, to_recode),
by = "row_id"
) %>%
mutate(
dm_type = case_when(
is.na(dm_type) & to_recode == TRUE  ~ 2,
is.na(dm_type) & is.na(to_recode)   ~ 1,
dm_type == 9 ~ NA_real_, #code refused as missing
.default = dm_type
)
) %>%
select(-row_id, -to_recode)
fp_data_sample2 %>% tabyl(dm_type)
