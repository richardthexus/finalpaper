final_data <- data_myvars_clean %>%
drop_na(
id, sex, metropolis, bmi_cat, marital, education, employment, ethnicity, age_grp, physical_health, mental_health, last_checkup, exercise, heart_attack, stroke, sight, memory, walk, deaf, ever_arthritis, asthma, ever_depression, age_had_dm, dm_type)
summary(final_data)
# Chunk 11
final_data_recoded <- final_data %>%
mutate(
sex = case_when(
sex == 2 ~ 1,
sex == 1 ~ 0, #male ref level
.default = sex
),
metropolis = case_when(
metropolis == 1 ~ 0, #yes
metropolis == 2 ~ 1,
.default = metropolis
),
sight = case_when(
sight == 2 ~ 0, #no ref
.default = sight
),
memory = case_when(
memory == 2 ~ 0, #no ref
.default = memory
),
walk = case_when(
walk == 2 ~ 0, #no ref
.default = walk
),
deaf = case_when(
deaf == 2 ~ 0, #no ref
.default = deaf
),
bmi_cat = case_when(
bmi_cat == 2 ~ 0, #normal weight ref level
bmi_cat == 1 ~ 1,
bmi_cat == 3 ~ 2,
bmi_cat == 4 ~ 3,
.default = bmi_cat
),
marital = case_when(
marital == 1 ~ 0, #married ref
marital == 2 ~ 1,
marital == 3 ~ 1,
marital == 4 ~ 1,
marital == 5 ~ 2,
marital == 6 ~ 2,
.default = marital
),
education = case_when(
education == 4 ~ 0, #college complete ref
.default = education
),
employment = case_when(
employment == 1 ~ 0, #employed/self-employed ref.
employment == 2 ~ 0,
employment == 3 ~ 1,
employment == 4 ~ 1,
employment == 5 ~ 1,
employment == 6 ~ 1,
employment == 7 ~ 1,
employment == 8 ~ 1,
.default = employment
),
ethnicity = case_when(
ethnicity == 1 ~ 0, #white ref.
ethnicity == 2 ~ 1, #black
ethnicity == 3 ~ 2,
ethnicity == 4 ~ 2,
ethnicity == 5 ~ 2,
ethnicity == 6 ~ 2,
.default = ethnicity
),
age_grp = case_when(
age_grp == 6 ~ 0, #65 years and older ref
age_grp == 1 ~ 1,
age_grp == 2 ~ 2,
age_grp == 3 ~ 3,
age_grp == 4 ~ 4,
age_grp == 5 ~ 5,
.default = age_grp
),
physical_health = case_when(
physical_health == 1 ~ 0, #zero days ref
physical_health == 2 ~ 1,
physical_health == 3 ~ 2,
.default = physical_health
),
mental_health = case_when(
mental_health == 1 ~ 0, #zero days ref
mental_health == 2 ~ 1,
mental_health == 3 ~ 2,
.default = mental_health
),
last_checkup = case_when(
last_checkup == 1 ~ 0, #within last year ref
last_checkup == 2 ~ 1,
last_checkup == 3 ~ 1,
last_checkup == 4 ~ 1,
last_checkup == 5 ~ 1,
.default = last_checkup
),
exercise = case_when(
exercise == 1 ~ 0, # yes ref
exercise == 2 ~ 1,
.default = exercise
),
stroke = case_when(
stroke == 2 ~ 0,
.default = stroke
),
asthma = case_when(
asthma == 2 ~ 0,
.default = asthma
),
heart_attack = case_when(
heart_attack == 2 ~ 0,
.default = heart_attack
),
ever_depression = case_when(
ever_depression == 2 ~ 0,
.default = ever_depression
),
ever_arthritis = case_when(
ever_arthritis == 2 ~ 0,
.default = ever_arthritis
),
dm_type = case_when(
dm_type == 2 ~ 0,
.default = dm_type
)
)
summary(final_data_recoded)
# Chunk 12
skim(final_data_recoded)
# Chunk 13
skim(final_data_recoded)
